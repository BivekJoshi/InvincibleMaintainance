// Maintenance System — data model draft
// Copy into apps/api/prisma/schema.prisma and migrate per phase.
// Money is ALWAYS Int paisa (NPR x 100). Dates are UTC.

generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

// ─────────────────────────── PHASE 1 · identity, settings, media

enum Role { ADMIN EDITOR SALES DISPATCHER TECHNICIAN ACCOUNTANT SURVEYOR }

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  passwordHash  String
  role          Role      @default(SALES)
  avatarId      String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  refreshTokens RefreshToken[]
  assignedLeads Lead[]          @relation("LeadAssignee")
  leadNotes     LeadNote[]
  technician    Technician?
  auditLogs     AuditLog[]
  @@index([role, isActive])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   // create | update | delete | login | export
  model     String
  recordId  String?
  changes   Json?    // { field: [before, after] }
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])
  @@index([model, recordId])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  group     String   // contact | seo | branding | sla | finance | integrations | social
  key       String   @unique
  value     Json
  type      String   @default("string") // string|number|boolean|json|media|richtext
  label     String
  updatedAt DateTime @updatedAt
  @@index([group])
}

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  media    Media[]
}

model Media {
  id         String   @id @default(cuid())
  folderId   String?
  path       String   // storage key of the original
  variants   Json?    // { "400": "...", "800": "...", "1600": "..." } WebP
  blurhash   String?
  mime       String
  size       Int
  width      Int?
  height     Int?
  alt        String?
  caption    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
  folder     MediaFolder? @relation(fields: [folderId], references: [id])
}

// Field-level en/ne translations for any model.
model Translation {
  id       String @id @default(cuid())
  model    String
  recordId String
  field    String
  locale   String // "en" | "ne"
  value    String
  @@unique([model, recordId, field, locale])
  @@index([model, recordId])
}

// ─────────────────────────── PHASE 2 · CMS

model HomeSection {
  id        String  @id @default(cuid())
  key       String  @unique // hero | services | projects | offers | gallery | why_choose | stats
                            // | seepage | interior | construction | renovation | pre_engineered
                            // | kitchen | pricing | other_civil | process | testimonials | cta_form
  title     String
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
  settings  Json?   // per-section options: limit, layout, background, headingOverride
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaUrl    String?
  imageId   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  deletedAt DateTime?
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  services  Service[]
  projects  Project[]
}

model Service {
  id              String   @id @default(cuid())
  categoryId      String?
  name            String
  slug            String   @unique
  excerpt         String            // short card text — must be unique copy, not boilerplate
  body            String?           // rich text detail page
  icon            String?
  imageId         String?
  type            String   @default("standard") // standard | other_civil
  priceFrom       Int?              // paisa
  priceTo         Int?
  priceUnit       String?           // sq.ft | rft | nos | hour | lump
  warrantyDays    Int?              // overrides the global default
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  ogImageId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  leads           Lead[]
  jobTemplates    JobTemplate[]
  @@index([isActive, sortOrder])
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  clientName      String?
  location        String?
  categoryId      String?
  status          String   @default("completed") // ongoing | completed
  summary         String?
  body            String?
  coverId         String?
  completedAt     DateTime?
  isFeatured      Boolean  @default(false)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  images          ProjectImage[]
  category        ServiceCategory? @relation(fields: [categoryId], references: [id])
  deletedAt       DateTime?

  // Case study: a finished job, published as the proof a customer reads before booking.
  serviceId    String?   // stronger than categoryId for "work like this"
  jobId        String?   @unique   // provenance; also blocks publishing twice
  problem      String?
  solution     String?
  outcome      String?
  durationDays Int?
  costBandMin  Int?      // paisa. A BAND, widened +/-20% — never the customer's contract value.
  costBandMax  Int?
  publishedAt  DateTime?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([serviceId, isActive])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  mediaId   String
  caption   String?
  sortOrder Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Offer {
  id          String    @id @default(cuid())
  title       String
  description String?
  bullets     Json?     // string[]
  badge       String?   // "Limited Time"
  priceMin    Int?
  priceMax    Int?
  startsAt    DateTime?
  endsAt      DateTime?
  ctaLabel    String?
  ctaUrl      String?
  imageId     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
}

model PricingPlan {
  id          String  @id @default(cuid())
  title       String
  badge       String? // Popular | Professional
  description String?
  priceMin    Int?
  priceMax    Int?
  unit        String? // /sq.ft
  inclusions  Json?   // string[]
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

// Reusable card blocks: group = why_choose | construction | pre_engineered | kitchen ...
model Feature {
  id          String  @id @default(cuid())
  group       String
  icon        String?
  imageId     String?
  title       String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  @@index([group, sortOrder])
}

// Numbered lists: group = renovation_reasons | kitchen_steps | seepage_checkpoints ...
model ListItem {
  id        String  @id @default(cuid())
  group     String
  position  Int
  text      String
  isActive  Boolean @default(true)
  @@index([group, position])
}

model ContentBlock {
  id         String  @id @default(cuid())
  key        String  @unique // seepage_explainer | interior_design | ...
  heading    String?
  subheading String?
  body       String?
  bullets    Json?
  imageId    String?
  cta        Json?   // { label, url }
  isActive   Boolean @default(true)
}

model ProcessStep {
  id          String @id @default(cuid())
  stepNo      Int
  title       String
  description String?
  icon        String?
  sortOrder   Int    @default(0)
}

model Testimonial {
  id         String  @id @default(cuid())
  quote      String
  author     String
  location   String?
  rating     Int     @default(5)
  photoId    String?
  locale     String  @default("en")
  jobId      String? // when it came from a post-job rating
  isApproved Boolean @default(false)
  sortOrder  Int     @default(0)
  createdAt  DateTime @default(now())
}

model GalleryImage {
  id        String  @id @default(cuid())
  mediaId   String
  caption   String?
  projectId String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  group     String? // general | pricing | warranty | service slug
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Page {
  id              String  @id @default(cuid())
  slug            String  @unique
  title           String
  body            String?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean @default(true)
  deletedAt       DateTime?
}

model PostCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id              String    @id @default(cuid())
  categoryId      String?
  title           String
  slug            String    @unique
  excerpt         String?
  body            String
  coverId         String?
  authorId        String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  isActive        Boolean   @default(true)
  category        PostCategory? @relation(fields: [categoryId], references: [id])
  deletedAt       DateTime?
}

// ─────────────────────────── PHASE 4 · leads

enum LeadStatus { NEW CONTACTED INSPECTION_SCHEDULED QUOTED WON LOST }
enum Priority   { LOW NORMAL HIGH URGENT }

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  altPhone        String?
  email           String?
  address         String?
  area            String?
  serviceId       String?
  message         String?
  estimatedAmount Int?       // from the public estimator
  estimatePayload Json?      // { sqft, service, rate } for reproducibility
  preferredAt     DateTime?  // online booking: the day the customer wants the visit
  preferredSlot   String?    // morning | afternoon | evening (Asia/Kathmandu windows)
  source          String     @default("web_form")
  sourcePage      String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  status          LeadStatus @default(NEW)
  priority        Priority   @default(NORMAL)
  assignedToId    String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  customerId      String?
  ip              String?
  userAgent       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  service    Service?   @relation(fields: [serviceId], references: [id])
  assignedTo User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  notes      LeadNote[]
  activities LeadActivity[]
  quotations Quotation[]
  jobs       Job[]
  @@index([status, createdAt])
  @@index([phone])
  @@index([slaDueAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  note      String
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String   // call | sms | email | whatsapp | visit | status_change | assignment
  summary   String
  meta      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@index([leadId, createdAt])
}

// ─────────────────────────── PHASE 5 · customers, rate card, quotations

model Customer {
  id         String   @id @default(cuid())
  type       String   @default("individual") // individual | company
  name       String
  phone      String
  altPhone   String?
  email      String?
  panVatNo   String?
  notes      String?
  tags       Json?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
  sites      CustomerSite[]
  leads      Lead[]
  quotations Quotation[]
  jobs       Job[]
  invoices   Invoice[]
  contracts  AmcContract[]
  @@index([phone])
}

model CustomerSite {
  id          String  @id @default(cuid())
  customerId  String
  label       String  // "Home — Ekantakuna"
  address     String
  area        String?
  lat         Float?
  lng         Float?
  accessNotes String?
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs        Job[]
  contracts   AmcContract[]
}

model RateCardItem {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  category  String?
  unit      String  // sq.ft | rft | nos | hour | lump
  rate      Int     // paisa
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

enum QuotationStatus { DRAFT SENT APPROVED REJECTED EXPIRED CONVERTED }

model Quotation {
  id           String          @id @default(cuid())
  number       String          @unique // QT-2082-0001
  version      Int             @default(1)
  parentId     String?         // previous version
  customerId   String
  siteId       String?
  leadId       String?
  status       QuotationStatus @default(DRAFT)
  validUntil   DateTime?
  subtotal     Int             @default(0)
  discount     Int             @default(0)
  vatApplied   Boolean         @default(true)
  vatAmount    Int             @default(0)
  total        Int             @default(0)
  terms        String?
  internalNote String?
  publicToken  String?         @unique
  sentAt       DateTime?
  decidedAt    DateTime?
  decidedIp    String?
  createdById  String?
  createdAt    DateTime        @default(now())
  items        QuotationItem[]
  customer     Customer        @relation(fields: [customerId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id])
  jobs         Job[]
}

model QuotationItem {
  id             String @id @default(cuid())
  quotationId    String
  rateCardItemId String?
  description    String
  unit           String?
  qty            Float  @default(1)
  rate           Int
  amount         Int
  sortOrder      Int    @default(0)
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

// ─────────────────────────── PHASE 6 · jobs & technicians

enum JobType   { INSPECTION REPAIR INSTALLATION RENOVATION AMC_VISIT WARRANTY }
enum JobStatus { DRAFT SCHEDULED ASSIGNED EN_ROUTE IN_PROGRESS ON_HOLD COMPLETED VERIFIED CANCELLED }

model Technician {
  id            String  @id @default(cuid())
  userId        String  @unique
  employeeCode  String? @unique
  skills        Json?   // string[] of service category slugs
  certifications Json?
  serviceAreas  Json?
  hourlyRate    Int?    // paisa, for costing
  dailyCapacity Int     @default(4)
  rating        Float   @default(0)
  isAvailable   Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments   JobAssignment[]
  timeLogs      TimeLog[]
}

model JobTemplate {
  id        String @id @default(cuid())
  serviceId String?
  name      String
  tasks     Json   // [{ title, description }]
  service   Service? @relation(fields: [serviceId], references: [id])
}

model Job {
  id             String    @id @default(cuid())
  number         String    @unique // JOB-2082-0001
  type           JobType   @default(REPAIR)
  customerId     String
  siteId         String?
  leadId         String?
  quotationId    String?
  parentJobId    String?   // warranty/rework parent
  title          String
  description    String?
  priority       Priority  @default(NORMAL)
  status         JobStatus @default(DRAFT)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  completionNote String?
  signatureId    String?
  customerRating Int?
  customerFeedback String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customer    Customer      @relation(fields: [customerId], references: [id])
  site        CustomerSite? @relation(fields: [siteId], references: [id])
  lead        Lead?         @relation(fields: [leadId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  tasks       JobTask[]
  assignments JobAssignment[]
  events      JobStatusEvent[]
  photos      JobPhoto[]
  timeLogs    TimeLog[]
  materials   JobMaterial[]
  invoiceItems InvoiceItem[]
  warranty    Warranty?
  @@index([status, scheduledStart])
  @@index([customerId])
}

model JobTask {
  id        String  @id @default(cuid())
  jobId     String
  title     String
  note      String?
  isDone    Boolean @default(false)
  isSkipped Boolean @default(false)
  doneAt    DateTime?
  sortOrder Int     @default(0)
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobAssignment {
  id           String   @id @default(cuid())
  jobId        String
  technicianId String
  isLead       Boolean  @default(false)
  acceptedAt   DateTime?
  declinedAt   DateTime?
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id])
  @@unique([jobId, technicianId])
}

model JobStatusEvent {
  id        String    @id @default(cuid())
  jobId     String
  from      JobStatus?
  to        JobStatus
  actorId   String?
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime  @default(now())
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  mediaId   String
  kind      String   // BEFORE | DURING | AFTER | ISSUE | SIGNATURE
  caption   String?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model TimeLog {
  id           String    @id @default(cuid())
  jobId        String
  technicianId String
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int?
  note         String?
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician   Technician @relation(fields: [technicianId], references: [id])
}

// ─────────────────────────── site surveys
//
// The visit is a Job of type INSPECTION; this is the report the surveyor fills in on
// site. QUANTITIES ONLY — no rate, no amount, no price snapshot. Pricing happens once,
// at review time, in survey.service.js#priceSurvey.

enum SurveyStatus   { DRAFT SUBMITTED IN_REVIEW RETURNED QUOTED CANCELLED }
enum SurveyItemKind { LABOUR MATERIAL SERVICE OTHER }

model SiteSurvey {
  id             String       @id @default(cuid())
  number         String       @unique       // SRV-2083-0001
  jobId          String       @unique       // the INSPECTION job; also makes create idempotent
  leadId         String?
  customerId     String
  siteId         String?
  serviceId      String?
  surveyorId     String?                    // Technician.id
  status         SurveyStatus @default(DRAFT)
  problemSummary String?                    // what the customer reports
  diagnosis      String?                    // what the surveyor found — cause, not symptom
  recommendation String?
  accessNotes    String?                    // scaffolding, parking, water point, stairs
  riskNotes      String?
  areaValue      Float?                     // headline measured quantity
  areaUnit       String?
  estimatedDays  Float?
  urgency        Priority     @default(NORMAL)
  submittedAt    DateTime?
  submittedById  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  returnedReason String?
  quotationId    String?      @unique       // the priced document this became
  deletedAt      DateTime?

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  surveyor    Technician?     @relation(fields: [surveyorId], references: [id], onDelete: SetNull)
  quotation   Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  readings    SurveyReading[]
  items       SurveyItem[]

  @@index([status, submittedAt])
  @@index([surveyorId, status])
}

// A moisture meter gives 18.4; "is there a DPC?" gives "none visible". Numeric AND text,
// not a Json blob — `value` is what the review screen thresholds on.
model SurveyReading {
  id        String   @id @default(cuid())
  surveyId  String
  label     String                    // "Ground floor west wall"
  metric    String                    // moisture | crack_width | slope | free text
  value     Float?
  unit      String?                   // % | mm | mm/m
  textValue String?
  location  String?
  mediaId   String?
  lat       Float?
  lng       Float?
  takenAt   DateTime @default(now())
  sortOrder Int      @default(0)

  survey SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
}

model SurveyItem {
  id             String         @id @default(cuid())
  surveyId       String
  kind           SurveyItemKind @default(MATERIAL)
  materialId     String?
  rateCardItemId String?
  serviceId      String?
  description    String         // required even when a catalogue row is linked — the FKs
                                // are SetNull, so a soft-deleted material must not blank the line
  unit           String
  qty            Float          // the only number the surveyor owns
  wastagePct     Float          @default(0)  // site judgement (cutting loss), not commercial
  isOptional     Boolean        @default(false)
  note           String?
  sortOrder      Int            @default(0)

  survey SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, sortOrder])
}

// ─────────────────────────── PHASE 7 · materials

model Supplier {
  id        String @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  materials Material[]
}

model MaterialCategory {
  id        String     @id @default(cuid())
  name      String
  sortOrder Int        @default(0)
  materials Material[]
}

model Material {
  id            String  @id @default(cuid())
  categoryId    String?
  supplierId    String?
  code          String  @unique
  name          String
  unit          String
  purchaseRate  Int     // paisa
  sellRate      Int
  reorderLevel  Float   @default(0)
  isActive      Boolean @default(true)
  category      MaterialCategory? @relation(fields: [categoryId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  jobMaterials  JobMaterial[]
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  type       String   // PURCHASE | ISSUE_TO_JOB | RETURN | ADJUSTMENT | WASTAGE
  qty        Float    // signed
  rate       Int?
  jobId      String?
  reference  String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id])
  @@index([materialId, createdAt])
}

model JobMaterial {
  id         String  @id @default(cuid())
  jobId      String
  materialId String
  qty        Float
  rate       Int     // captured at issue time
  isBillable Boolean @default(true)
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id])
}

// ─────────────────────────── PHASE 8 · finance

enum InvoiceStatus { DRAFT SENT PARTIAL PAID OVERDUE VOID }

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique // INV-2082-0001
  customerId  String
  quotationId String?
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  subtotal    Int           @default(0)
  discount    Int           @default(0)
  vatApplied  Boolean       @default(true)
  vatAmount   Int           @default(0)
  total       Int           @default(0)
  paidAmount  Int           @default(0)
  note        String?
  publicToken String?       @unique
  customer    Customer      @relation(fields: [customerId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String @id @default(cuid())
  invoiceId   String
  jobId       String?
  description String
  unit        String?
  qty         Float  @default(1)
  rate        Int
  amount      Int
  sortOrder   Int    @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  job         Job?    @relation(fields: [jobId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  amount     Int
  method     String   // CASH | BANK | ESEWA | KHALTI | FONEPAY | CHEQUE
  reference  String?
  receivedAt DateTime @default(now())
  receivedBy String?
  note       String?
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id         String   @id @default(cuid())
  category   String
  amount     Int
  jobId      String?
  vendor     String?
  billMediaId String?
  spentAt    DateTime @default(now())
  approvedBy String?
  note       String?
}

// ─────────────────────────── PHASE 9 · aftercare

enum WarrantyStatus { ACTIVE EXPIRED VOID CLAIMED }

model Warranty {
  id          String         @id @default(cuid())
  jobId       String         @unique
  customerId  String
  scope       String?
  startsAt    DateTime
  endsAt      DateTime
  status      WarrantyStatus @default(ACTIVE)
  certificateId String?
  publicToken String?        @unique
  job         Job            @relation(fields: [jobId], references: [id])
  claims      WarrantyClaim[]
  @@index([endsAt, status])
}

model WarrantyClaim {
  id          String   @id @default(cuid())
  warrantyId  String
  description String
  status      String   @default("open") // open | accepted | rejected | resolved
  resolvedJobId String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  warranty    Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
}

model AmcContract {
  id            String   @id @default(cuid())
  number        String   @unique // AMC-2082-0001
  customerId    String
  siteId        String?
  planName      String
  coveredServices Json?
  startDate     DateTime
  endDate       DateTime
  visitsPerYear Int      @default(4)
  amount        Int
  billingCycle  String   @default("annual") // annual | quarterly | monthly
  status        String   @default("active") // active | expired | cancelled
  customer      Customer      @relation(fields: [customerId], references: [id])
  site          CustomerSite? @relation(fields: [siteId], references: [id])
  visits        AmcVisit[]
  @@index([endDate, status])
}

model AmcVisit {
  id         String   @id @default(cuid())
  contractId String
  dueDate    DateTime
  jobId      String?
  status     String   @default("pending") // pending | scheduled | done | missed
  contract   AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model ServiceReminder {
  id         String   @id @default(cuid())
  customerId String
  jobId      String?
  serviceId  String?
  dueAt      DateTime
  channel    String   @default("sms")
  message    String
  sentAt     DateTime?
  status     String   @default("pending")
  @@index([dueAt, status])
}

// ─────────────────────────── PHASE 11 · comms

model MessageTemplate {
  id       String  @id @default(cuid())
  key      String  @unique // lead_new_sms | sla_breach_email | job_complete_sms | invoice_overdue
  channel  String  // sms | email | inapp
  locale   String  @default("en")
  subject  String?
  body     String  // supports {{variables}}
  isActive Boolean @default(true)
}

model MessageLog {
  id         String   @id @default(cuid())
  channel    String
  templateKey String?
  toAddress  String
  subject    String?
  body       String
  provider   String?
  providerId String?
  status     String   @default("queued") // queued | sent | failed | delivered
  error      String?
  relatedModel String?
  relatedId  String?
  createdAt  DateTime @default(now())
  @@index([status, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, readAt])
}
