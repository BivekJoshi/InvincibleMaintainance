# ── Core
NODE_ENV=development
PORT=4000
APP_NAME="Maintenance System"
APP_URL=http://localhost:4000

# ── Database (required)
DATABASE_URL="postgresql://maintainance:maintainance@localhost:5432/maintainance?schema=public"

# ── Auth (required — generate with: openssl rand -hex 32)
JWT_SECRET=change_me_access_secret_min_32_chars_long_here
REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_ok
ACCESS_TOKEN_TTL=15m
# Sessions per client, in days (0.5 = 12 hours). A session ends after IDLE days without use,
# and MAX days after sign-in however active. The client is chosen at login (`client` in the body).
WEB_SESSION_IDLE_DAYS=7
WEB_SESSION_MAX_DAYS=30
DESKTOP_SESSION_IDLE_DAYS=30
DESKTOP_SESSION_MAX_DAYS=90
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ── CORS origins (comma separated)
PUBLIC_WEB_ORIGIN=http://localhost:5400
ADMIN_ORIGIN=http://localhost:5174

# ── Redis (optional — falls back to an in-process queue + memory cache when blank)
REDIS_URL=

# ── Storage: local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email (blank SMTP_HOST = log to console)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Maintenance System <no-reply@example.com>"

# ── SMS: console | sparrow | aakash
SMS_DRIVER=console
SPARROW_TOKEN=
SPARROW_FROM=Demo
AAKASH_TOKEN=

# ── Anti-spam
TURNSTILE_SECRET=
LEAD_RATE_LIMIT_PER_HOUR=5

# ── Business rules
VAT_RATE=13
SLA_LEAD_MINUTES=120
SLA_WARN_BEFORE_MINUTES=30
WARRANTY_DEFAULT_DAYS=30
CURRENCY=NPR
TIMEZONE=Asia/Kathmandu

# ── Observability
# trace | debug | info | warn | error | fatal | silent. Blank = info in production, debug otherwise.
LOG_LEVEL=
# Optional JSON file sink next to stdout, rotated daily (pino-roll): logs/api.log writes logs/api.2026-09-14.1.log. Blank = stdout only.
LOG_FILE=
# Rotated log files kept besides the current one when LOG_FILE is set.
LOG_RETENTION_DAYS=14
# Optional error reporting (@sentry/node, loaded only when set): 5xx errors, failed tasks, crashes.
SENTRY_DSN=
