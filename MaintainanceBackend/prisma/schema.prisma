  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([isApproved, sortOrder])
}

model GalleryImage {
  id        String    @id @default(cuid())
  mediaId   String
  caption   String?
  projectId String?
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
