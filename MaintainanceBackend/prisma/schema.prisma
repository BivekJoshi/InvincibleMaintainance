}

model Post {
  id              String    @id @default(cuid())
  categoryId      String?
  title           String
  slug            String    @unique
  excerpt         String?
  body            String
  coverId         String?
  authorId        String?
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
