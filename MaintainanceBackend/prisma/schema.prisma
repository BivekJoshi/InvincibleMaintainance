// Maintenance System — Prisma schema
// Money is ALWAYS Int paisa (NPR x 100). Timestamps are UTC.
// Media references are plain String ids (no FK) to avoid ~20 back-relations on Media;
// orphan detection is handled by the media:sweep cron.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════ identity, settings, media

enum Role {
  ADMIN
  EDITOR
  SALES
  /// every SALES capability plus quotations:approve (Phase F)
  MANAGER
  DISPATCHER
  TECHNICIAN
  ACCOUNTANT
  SURVEYOR
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(SALES)
  avatarId     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  assignedLeads    Lead[]           @relation("LeadAssignee")
  leadNotes        LeadNote[]
  leadActivities   LeadActivity[]
  technician       Technician?
  auditLogs        AuditLog[]
  notifications    Notification[]
  shortcuts        UserShortcut[]
  notes            UserNote[]
  createdQuotes    Quotation[]      @relation("QuotationCreator")
  submittedQuotes  Quotation[]      @relation("QuotationSubmitter")
  approvedQuotes   Quotation[]      @relation("QuotationApprover")
  createdJobs      Job[]            @relation("JobCreator")
  jobEvents        JobStatusEvent[]
  submittedSurveys SiteSurvey[]     @relation("SurveySubmitter")
  reviewedSurveys  SiteSurvey[]     @relation("SurveyReviewer")

  @@index([role, isActive])
  @@index([deletedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per audited write (a model change: action create|update|upsert|delete, event null)
/// or per domain event (event set, e.g. "quotation.customer_approved"; action is the part after the dot).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  /// user | public | system — a signed-in user, a form or token link, or a task
  actorType String   @default("user")
  action    String
  /// Domain event name from AUDIT_EVENTS; null on a plain model-change row
  event     String?
  model     String
  recordId  String?
  /// Rows before Phase B: the sanitized write data. Domain events: their meta. Model changes: null (see before/after)
  changes   Json?
  /// Shallow, redacted snapshot of the changed scalar fields before the write (null on create)
  before    Json?
  /// The same fields after the write (null on delete)
  after     Json?
  /// X-Request-Id of the request, or "<task>:<job id>" for background work
  requestId String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([model, recordId])
  @@index([createdAt])
  @@index([actorId])
  @@index([event, createdAt])
  @@index([requestId])
}

model Setting {
  id        String   @id @default(cuid())
  group     String
  key       String   @unique
  value     Json
  type      String   @default("string")
  label     String
  hint      String?
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@index([group])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MediaFolder[] @relation("FolderTree")
  media    Media[]
}

model Media {
  id         String    @id @default(cuid())
  folderId   String?
  path       String
  variants   Json?
  blurhash   String?
  mime       String
  size       Int
  width      Int?
  height     Int?
  alt        String?
  caption    String?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  folder MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([deletedAt])
}

model Translation {
  id       String @id @default(cuid())
  model    String
  recordId String
  field    String
  locale   String
  value    String

  @@unique([model, recordId, field, locale])
  @@index([model, recordId])
}

// ═══════════════════════════ CMS

