// ═══════════════════════════ CRM

enum LeadStatus {
  NEW
  CONTACTED
  INSPECTION_SCHEDULED
  QUOTED
  WON
  LOST
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  phone           String
  altPhone        String?
  email           String?
  address         String?
  area            String?
  serviceId       String?
  message         String?
  estimatedAmount Int?
  estimatePayload Json?
  preferredAt     DateTime?
  preferredSlot   String?
  source          String     @default("web_form")
  sourcePage      String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  status          LeadStatus @default(NEW)
  priority        Priority   @default(NORMAL)
  assignedToId    String?
  slaDueAt        DateTime?
  slaBreached     Boolean    @default(false)
  firstResponseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  customerId      String?
  /// en | ne — the language customer SMS and email use (the site's language when they enquired)
  preferredLocale String     @default("en")
  ip              String?
  userAgent       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  service    Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  customer   Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  notes      LeadNote[]
  activities LeadActivity[]
  quotations Quotation[]
  jobs       Job[]
  surveys    SiteSurvey[]

  @@index([status, createdAt])
  @@index([phone])
  @@index([slaDueAt, firstResponseAt])
  @@index([assignedToId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  note      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  type      String
  summary   String
  meta      Json?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model Customer {
  id              String    @id @default(cuid())
  type            String    @default("individual")
  name            String
  phone           String
  altPhone        String?
  email           String?
  panVatNo        String?
  notes           String?
  tags            Json?
  /// en | ne — the language customer SMS and email use
  preferredLocale String    @default("en")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  sites      CustomerSite[]
  leads      Lead[]
  quotations Quotation[]
  jobs       Job[]
  invoices   Invoice[]
  contracts  AmcContract[]
  warranties Warranty[]
  reminders  ServiceReminder[]
  surveys    SiteSurvey[]

  @@index([phone])
  @@index([deletedAt])
}

model CustomerSite {
  id          String    @id @default(cuid())
  customerId  String
  label       String
  address     String
  area        String?
  lat         Float?
  lng         Float?
  accessNotes String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs       Job[]
  contracts  AmcContract[]
  quotations Quotation[]
  surveys    SiteSurvey[]

  @@index([customerId])
}

model RateCardItem {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  category    String?
  unit        String
  rate        Int
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  quotationItems QuotationItem[]
  surveyItems    SurveyItem[]

  @@index([isActive, sortOrder])
}

/// APPROVED means the *customer* accepted; OFFICE_APPROVED is the internal approval.
enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  OFFICE_APPROVED
  SENT
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
  CONVERTED
}

model Quotation {
  id               String          @id @default(cuid())
  number           String          @unique
  version          Int             @default(1)
  parentId         String?
  customerId       String
  siteId           String?
  leadId           String?
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?
  subtotal         Int             @default(0)
  discount         Int             @default(0)
  vatApplied       Boolean         @default(true)
  vatRate          Int             @default(13)
  vatAmount        Int             @default(0)
  total            Int             @default(0)
  terms            String?
  internalNote     String?
  publicToken      String?         @unique
  submittedAt      DateTime?
  submittedById    String?
  approvedById     String?
  approvedAt       DateTime?
  approvalNote     String?
  /// true when quotation.autoApproveBelow approved it (approvedById stays null)
  autoApproved     Boolean         @default(false)
  /// why it went back to DRAFT: an approver's send-back or a pull-back before sending
  sentBackReason   String?
  sentAt           DateTime?
  decidedAt        DateTime?
  decidedIp        String?
  decidedUserAgent String?
  /// the customer's own answer to this version: a change request or a decline reason
  decisionNote     String?
  /// the change request this revision answers, copied from the parent; never overwritten
  requestedChanges String?
  /// the newer version that replaced this one (status SUPERSEDED)
  supersededById   String?
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site         CustomerSite?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy  User?           @relation("QuotationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy   User?           @relation("QuotationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  parent       Quotation?      @relation("QuotationVersions", fields: [parentId], references: [id], onDelete: SetNull)
  revisions    Quotation[]     @relation("QuotationVersions")
  supersededBy Quotation?      @relation("QuotationSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   Quotation[]     @relation("QuotationSupersession")
  items        QuotationItem[]
  jobs         Job[]
  invoices     Invoice[]
  survey       SiteSurvey?

  @@index([status, createdAt])
  @@index([customerId])
  @@index([parentId])
  @@index([leadId])
}

model QuotationItem {
  id             String  @id @default(cuid())
  quotationId    String
  rateCardItemId String?
  description    String
  unit           String?
  qty            Float   @default(1)
  rate           Int
  amount         Int
  sortOrder      Int     @default(0)

  quotation    Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rateCardItem RateCardItem? @relation(fields: [rateCardItemId], references: [id], onDelete: SetNull)

  @@index([quotationId, sortOrder])
}

// ═══════════════════════════ Operations

enum JobType {
  INSPECTION
  REPAIR
  INSTALLATION
  RENOVATION
  AMC_VISIT
  WARRANTY
}

enum JobStatus {
  DRAFT
  SCHEDULED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  VERIFIED
  CANCELLED
}

model Technician {
  id             String    @id @default(cuid())
  userId         String    @unique
  employeeCode   String?   @unique
  skills         Json?
  certifications Json?
  serviceAreas   Json?
  hourlyRate     Int?
  dailyCapacity  Int       @default(4)
  rating         Float     @default(0)
  ratingCount    Int       @default(0)
  isAvailable    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments JobAssignment[]
  timeLogs    TimeLog[]
  surveys     SiteSurvey[]
}

model JobTemplate {
  id          String    @id @default(cuid())
  serviceId   String?
  name        String
  description String?
  tasks       Json
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

model Job {
  id               String    @id @default(cuid())
  number           String    @unique
  type             JobType   @default(REPAIR)
  customerId       String
  siteId           String?
  leadId           String?
  quotationId      String?
  parentJobId      String?
  title            String
  description      String?
  priority         Priority  @default(NORMAL)
  status           JobStatus @default(DRAFT)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  actualStart      DateTime?
  actualEnd        DateTime?
  holdReason       String?
  cancelReason     String?
  completionNote   String?
  signatureId      String?
  customerRating   Int?
  customerFeedback String?
  isBillable       Boolean   @default(true)
  invoicedAt       DateTime?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site         CustomerSite?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lead         Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotation    Quotation?       @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("JobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  parentJob    Job?             @relation("JobRework", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs    Job[]            @relation("JobRework")
  tasks        JobTask[]
  assignments  JobAssignment[]
  events       JobStatusEvent[]
  photos       JobPhoto[]
  timeLogs     TimeLog[]
  materials    JobMaterial[]
  invoiceItems InvoiceItem[]
  expenses     Expense[]
  warranty     Warranty?
  amcVisit     AmcVisit?
  survey       SiteSurvey?
  project      Project?

  @@index([status, scheduledStart])
  @@index([customerId])
  @@index([type, status])
}

model JobTask {
  id        String    @id @default(cuid())
  jobId     String
  title     String
  note      String?
  isDone    Boolean   @default(false)
  isSkipped Boolean   @default(false)
  doneAt    DateTime?
  sortOrder Int       @default(0)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, sortOrder])
}

model JobAssignment {
  id           String    @id @default(cuid())
  jobId        String
  technicianId String
  isLead       Boolean   @default(false)
  acceptedAt   DateTime?
  declinedAt   DateTime?
  createdAt    DateTime  @default(now())

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([jobId, technicianId])
  @@index([technicianId])
}

model JobStatusEvent {
  id        String     @id @default(cuid())
  jobId     String
  from      JobStatus?
  to        JobStatus
  actorId   String?
  note      String?
  lat       Float?
  lng       Float?
  createdAt DateTime   @default(now())

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  mediaId   String
  kind      String
  caption   String?
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, kind])
}

model TimeLog {
  id           String    @id @default(cuid())
  jobId        String
  technicianId String
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int?
  note         String?

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  technician Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([technicianId, startedAt])
}

// ═══════════════════════════ Site surveys
//
// The visit itself is a Job of type INSPECTION — this is the report the surveyor
// fills in while standing on the site. It carries QUANTITIES ONLY: no rate, no
// amount, no price snapshot anywhere below. Pricing happens once, at review time,
// in survey.service.js#priceSurvey against the rate card and material sell rates.

enum SurveyStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  RETURNED
  QUOTED
  CANCELLED
}

enum SurveyItemKind {
  LABOUR
  MATERIAL
  SERVICE
  OTHER
}

model SiteSurvey {
  id             String       @id @default(cuid())
  number         String       @unique
  jobId          String       @unique
  leadId         String?
  customerId     String
  siteId         String?
  serviceId      String?
  surveyorId     String?
  status         SurveyStatus @default(DRAFT)
  problemSummary String?
  diagnosis      String?
  recommendation String?
  accessNotes    String?
  riskNotes      String?
  areaValue      Float?
  areaUnit       String?
  estimatedDays  Float?
  urgency        Priority     @default(NORMAL)
  submittedAt    DateTime?
  submittedById  String?
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  returnedReason String?
  quotationId    String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site        CustomerSite?   @relation(fields: [siteId], references: [id], onDelete: SetNull)
  service     Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  surveyor    Technician?     @relation(fields: [surveyorId], references: [id], onDelete: SetNull)
  submittedBy User?           @relation("SurveySubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?           @relation("SurveyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  quotation   Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  readings    SurveyReading[]
  items       SurveyItem[]

  @@index([status, submittedAt])
  @@index([surveyorId, status])
  @@index([customerId])
  @@index([deletedAt])
}

// A moisture meter gives 18.4; "is there a DPC?" gives "none visible". Both are
// readings, so both a numeric and a text column — not a Json blob, because `value`
// is what the review screen thresholds on and what reports group by.
model SurveyReading {
  id        String   @id @default(cuid())
  surveyId  String
  label     String
  metric    String
  value     Float?
  unit      String?
  textValue String?
  location  String?
  mediaId   String?
  lat       Float?
  lng       Float?
  takenAt   DateTime @default(now())
  sortOrder Int      @default(0)

  survey SiteSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId, sortOrder])
}

model SurveyItem {
  id             String         @id @default(cuid())
  surveyId       String
  kind           SurveyItemKind @default(MATERIAL)
  materialId     String?
  rateCardItemId String?
  serviceId      String?
  description    String
  unit           String
  qty            Float
  wastagePct     Float          @default(0)
  isOptional     Boolean        @default(false)
  note           String?
  sortOrder      Int            @default(0)
  createdAt      DateTime       @default(now())

  survey       SiteSurvey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  material     Material?     @relation(fields: [materialId], references: [id], onDelete: SetNull)
  rateCardItem RateCardItem? @relation(fields: [rateCardItemId], references: [id], onDelete: SetNull)
  service      Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([surveyId, sortOrder])
  @@index([materialId])
  @@index([rateCardItemId])
}

// ═══════════════════════════ Materials

model Supplier {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  materials Material[]
}

model MaterialCategory {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  materials Material[]
}

model Material {
  id           String    @id @default(cuid())
  categoryId   String?
  supplierId   String?
  code         String    @unique
  name         String
  unit         String
  purchaseRate Int       @default(0)
  sellRate     Int       @default(0)
  reorderLevel Float     @default(0)
  isActive     Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  category     MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier     Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  jobMaterials JobMaterial[]
  surveyItems  SurveyItem[]

  @@index([isActive, sortOrder])
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  type       String
  qty        Float
  rate       Int?
  jobId      String?
  reference  String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, createdAt])
  @@index([jobId])
}

model JobMaterial {
  id         String   @id @default(cuid())
  jobId      String
  materialId String
  qty        Float
  rate       Int
  isBillable Boolean  @default(true)
  createdAt  DateTime @default(now())

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([jobId])
}

// ═══════════════════════════ Finance

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  customerId  String
  quotationId String?
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  subtotal    Int           @default(0)
  discount    Int           @default(0)
  vatApplied  Boolean       @default(true)
  vatRate     Int           @default(13)
  vatAmount   Int           @default(0)
  total       Int           @default(0)
  paidAmount  Int           @default(0)
  note        String?
  terms       String?
  publicToken String?       @unique
  sentAt      DateTime?
  voidReason  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  customer  Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotation Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]

  @@index([status, dueDate])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  jobId       String?
  description String
  unit        String?
  qty         Float   @default(1)
  rate        Int
  amount      Int
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sortOrder])
}

model Payment {
  id         String    @id @default(cuid())
  invoiceId  String
  amount     Int
  method     String
  reference  String?
  receivedAt DateTime  @default(now())
  receivedBy String?
  note       String?
  // A payment is never deleted. Voiding keeps the row, and every paid total ignores it.
  voidedAt   DateTime?
  voidReason String?
  voidedById String?
  createdAt  DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([receivedAt])
}

model Expense {
  id          String    @id @default(cuid())
  category    String
  amount      Int
  jobId       String?
  vendor      String?
  billMediaId String?
  spentAt     DateTime  @default(now())
  approvedBy  String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  job Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([spentAt])
  @@index([jobId])
}

// ═══════════════════════════ Aftercare

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
  CLAIMED
}

model Warranty {
  id            String         @id @default(cuid())
  jobId         String         @unique
  customerId    String
  scope         String?
  startsAt      DateTime
  endsAt        DateTime
  status        WarrantyStatus @default(ACTIVE)
  certificateId String?
  publicToken   String?        @unique
  voidReason    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job      Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  claims   WarrantyClaim[]

  @@index([endsAt, status])
}

model WarrantyClaim {
  id            String    @id @default(cuid())
  warrantyId    String
  description   String
  status        String    @default("open")
  resolvedJobId String?
  rejectReason  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  warranty Warranty @relation(fields: [warrantyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AmcContract {
  id              String    @id @default(cuid())
  number          String    @unique
  customerId      String
  siteId          String?
  planName        String
  coveredServices Json?
  startDate       DateTime
  endDate         DateTime
  visitsPerYear   Int       @default(4)
  amount          Int
  billingCycle    String    @default("annual")
  status          String    @default("active")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  site     CustomerSite? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  visits   AmcVisit[]

  @@index([endDate, status])
  @@index([customerId])
}

model AmcVisit {
  id         String   @id @default(cuid())
  contractId String
  dueDate    DateTime
  jobId      String?  @unique
  status     String   @default("pending")
  note       String?
  createdAt  DateTime @default(now())

  contract AmcContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  job      Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([dueDate, status])
}

model ServiceReminder {
  id         String    @id @default(cuid())
  customerId String
  jobId      String?
  serviceId  String?
  dueAt      DateTime
  channel    String    @default("sms")
  message    String
  sentAt     DateTime?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([dueAt, status])
}

// ═══════════════════════════ Comms

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String
  channel   String
  locale    String   @default("en")
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, channel, locale])
}

model MessageLog {
  id           String   @id @default(cuid())
  channel      String
  templateKey  String?
  toAddress    String
  subject      String?
  body         String
  provider     String?
  providerId   String?
  status       String   @default("queued")
  error        String?
  relatedModel String?
  relatedId    String?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([relatedModel, relatedId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// Per-user admin-shell preferences: the quick-links bar and sticky notes. Own rows only.
model UserShortcut {
  id        String   @id @default(cuid())
  userId    String
  label     String
  to        String
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, to])
  @@index([userId, sortOrder])
}

model UserNote {
  id        String    @id @default(cuid())
  userId    String
  body      String
  color     String    @default("yellow")
  isPinned  Boolean   @default(false)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt])
}

model Counter {
  id        String   @id @default(cuid())
  scope     String
  year      Int
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([scope, year])
}
